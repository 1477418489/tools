<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import plugin.javafxtools.control.LogViewer?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.LogMonitorController"
      spacing="12" prefWidth="1000" prefHeight="700"
      styleClass="tool-page, accent-amber, log-monitor-page">

    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <Label text="日志监控" styleClass="page-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="monitorStatusLabel" text="初始化中"
               styleClass="status-badge, status-offline"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar-card, log-monitor-toolbar">
        <TextField fx:id="logFileField" promptText="选择或输入要监听的日志文件"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button fx:id="chooseFileButton" text="选择文件" onAction="#selectLogFile"/>
        <Button fx:id="saveConfigButton" text="保存" onAction="#saveConfig"/>
        <Separator orientation="VERTICAL"/>
        <Button fx:id="startMonitorButton" text="启动" onAction="#startMonitoring"
                styleClass="primary-button"/>
        <Button fx:id="stopMonitorButton" text="停止" onAction="#stopMonitoring"
                styleClass="danger-button"/>
    </HBox>

    <SplitPane dividerPositions="0.49" VBox.vgrow="ALWAYS"
               styleClass="log-monitor-workspace">
        <items>
            <VBox spacing="10" minWidth="420" styleClass="surface, log-monitor-rule-surface">
                <HBox alignment="CENTER_LEFT" styleClass="section-header">
                    <Label text="匹配规则" styleClass="section-title"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label text="支持文本、完整词元和正则" styleClass="status-muted"/>
                </HBox>

                <HBox spacing="8" alignment="BOTTOM_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="规则名称" styleClass="field-label"/>
                        <TextField fx:id="ruleNameField" promptText="例如 HTTP 429"
                                   maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="匹配方式" styleClass="field-label"/>
                        <ComboBox fx:id="matchModeComboBox" prefWidth="132"/>
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="匹配内容" styleClass="field-label"/>
                    <TextField fx:id="ruleExpressionField"
                               promptText="状态码、多字符文本或正则表达式"
                               styleClass="log-monitor-expression-field"/>
                </VBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="caseSensitiveCheckBox" text="区分大小写" selected="true"/>
                    <CheckBox fx:id="ruleEnabledCheckBox" text="启用规则" selected="true"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button fx:id="addRuleButton" text="新增" onAction="#addRule"
                            styleClass="primary-button, compact-button"/>
                    <Button fx:id="updateRuleButton" text="更新" onAction="#updateRule"
                            styleClass="compact-button"/>
                    <Button fx:id="deleteRuleButton" text="删除" onAction="#deleteRule"
                            styleClass="danger-button, compact-button"/>
                </HBox>

                <TableView fx:id="ruleTable" VBox.vgrow="ALWAYS"
                           fixedCellSize="30" styleClass="log-monitor-rule-table">
                    <columns>
                        <TableColumn fx:id="ruleNameColumn" text="名称" prefWidth="112"/>
                        <TableColumn fx:id="ruleExpressionColumn" text="表达式" prefWidth="150"/>
                        <TableColumn fx:id="ruleModeColumn" text="方式" prefWidth="92"/>
                        <TableColumn fx:id="ruleCaseColumn" text="大小写" prefWidth="66"/>
                        <TableColumn fx:id="ruleEnabledColumn" text="状态" prefWidth="58"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" styleClass="empty-state">
                            <Label text="暂无匹配规则" styleClass="sub-title"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

            <VBox spacing="8" minWidth="440" styleClass="surface, log-monitor-match-surface">
                <HBox alignment="CENTER_LEFT" styleClass="section-header">
                    <Label text="最近命中" styleClass="section-title"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label fx:id="matchCountLabel" text="0 条" styleClass="status-muted"/>
                </HBox>

                <TableView fx:id="matchTable" VBox.vgrow="ALWAYS"
                           fixedCellSize="30" styleClass="log-monitor-match-table">
                    <columns>
                        <TableColumn fx:id="matchTimeColumn" text="时间" prefWidth="142"/>
                        <TableColumn fx:id="matchRuleColumn" text="规则" prefWidth="110"/>
                        <TableColumn fx:id="matchExpressionColumn" text="匹配内容" prefWidth="110"/>
                        <TableColumn fx:id="matchLineColumn" text="日志行" prefWidth="330"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" styleClass="empty-state">
                            <Label text="尚未检测到规则命中" styleClass="sub-title"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </items>
    </SplitPane>

    <LogViewer fx:id="logViewer" title="监控日志" windowTitle="日志监控运行记录"
               promptText="等待监听事件" wrapText="true"/>
</VBox>

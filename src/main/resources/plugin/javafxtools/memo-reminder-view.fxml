<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import plugin.javafxtools.control.LogViewer?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.MemoReminderController"
      spacing="12" prefWidth="1000" prefHeight="700" styleClass="tool-page, accent-rose">

    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <Label text="备忘提醒" styleClass="page-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="reminderCountLabel" text="0 条提醒" styleClass="status-badge, status-offline"/>
    </HBox>

    <VBox spacing="12" styleClass="surface, reminder-composer">
        <HBox alignment="CENTER_LEFT">
            <Label text="新建提醒" styleClass="section-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <HBox styleClass="segmented-control">
                <ToggleButton fx:id="intervalModeButton" text="按间隔" styleClass="segment-button, segment-first"/>
                <ToggleButton fx:id="atTimeModeButton" text="指定时间" styleClass="segment-button, segment-last"/>
            </HBox>
        </HBox>

        <VBox spacing="5">
            <Label text="备忘内容" styleClass="field-label"/>
            <TextArea fx:id="memoInput" prefRowCount="2" minHeight="62" prefHeight="62" maxHeight="62"
                      promptText="输入需要提醒的事项" wrapText="true" styleClass="memo-input"/>
        </VBox>

        <HBox spacing="10" alignment="BOTTOM_LEFT">
            <HBox fx:id="intervalOptions" spacing="10" alignment="BOTTOM_LEFT" HBox.hgrow="ALWAYS">
                <VBox spacing="5">
                    <Label text="提醒间隔" styleClass="field-label"/>
                    <TextField fx:id="intervalField" text="30" prefWidth="112"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="时间单位" styleClass="field-label"/>
                    <ComboBox fx:id="intervalUnitBox" prefWidth="120"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="提醒次数" styleClass="field-label"/>
                    <TextField fx:id="timesField" text="1" prefWidth="112">
                        <tooltip>
                            <Tooltip text="小于或等于 0 时持续提醒"/>
                        </tooltip>
                    </TextField>
                </VBox>
            </HBox>

            <HBox fx:id="atTimeOptions" spacing="10" alignment="BOTTOM_LEFT"
                  visible="false" managed="false" HBox.hgrow="ALWAYS">
                <VBox spacing="5">
                    <Label text="提醒日期" styleClass="field-label"/>
                    <DatePicker fx:id="reminderDatePicker" prefWidth="170" editable="false"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="提醒时间" styleClass="field-label"/>
                    <TextField fx:id="reminderTimeField" prefWidth="132" promptText="HH:mm:ss"/>
                </VBox>
            </HBox>

            <Button fx:id="addButton" text="新增提醒" minWidth="106" onAction="#addReminder"
                    styleClass="primary-button"/>
        </HBox>
    </VBox>

    <VBox spacing="7" styleClass="surface" VBox.vgrow="ALWAYS">
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="section-header">
            <Label text="提醒列表" styleClass="section-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="pauseButton" text="暂停" onAction="#pauseSelected" styleClass="compact-button"/>
            <Button fx:id="resumeButton" text="恢复" onAction="#resumeSelected" styleClass="compact-button"/>
            <Button fx:id="removeButton" text="删除" onAction="#removeSelected"
                    styleClass="danger-button, compact-button"/>
        </HBox>
        <TableView fx:id="reminderTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="contentCol" text="内容" prefWidth="390"/>
                <TableColumn fx:id="scheduleCol" text="计划" prefWidth="125"/>
                <TableColumn fx:id="remainCol" text="剩余次数" prefWidth="100"/>
                <TableColumn fx:id="nextTimeCol" text="下次提醒" prefWidth="210"/>
                <TableColumn fx:id="statusCol" text="状态" prefWidth="100"/>
            </columns>
            <placeholder>
                <VBox alignment="CENTER" styleClass="empty-state">
                    <Label text="暂无提醒" styleClass="sub-title"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>

    <LogViewer fx:id="logViewer" title="模块日志" promptText="等待提醒事件"/>
</VBox>

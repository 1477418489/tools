<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.DevEnvironmentController"
      spacing="12" styleClass="tool-page">
    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <Label text="开发环境体检" styleClass="page-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="等待体检" styleClass="status-badge, status-offline"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar-card">
        <Label text="本机工具链" styleClass="section-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="copyButton" text="复制报告" onAction="#handleCopyReport"/>
        <Button fx:id="inspectButton" text="重新体检" onAction="#handleInspect"
                styleClass="primary-button"/>
    </HBox>

    <GridPane hgap="10" styleClass="metric-strip">
        <columnConstraints>
            <ColumnConstraints percentWidth="30" fillWidth="true"/>
            <ColumnConstraints percentWidth="30" fillWidth="true"/>
            <ColumnConstraints percentWidth="40" fillWidth="true"/>
        </columnConstraints>
        <VBox spacing="3" styleClass="surface, metric-tile" GridPane.columnIndex="0">
            <Label text="可用工具" styleClass="metric-label"/>
            <Label fx:id="availableCountLabel" text="--" styleClass="metric-value"/>
        </VBox>
        <VBox spacing="3" styleClass="surface, metric-tile" GridPane.columnIndex="1">
            <Label text="核心问题" styleClass="metric-label"/>
            <Label fx:id="issueCountLabel" text="--" styleClass="metric-value"/>
        </VBox>
        <VBox spacing="3" styleClass="surface, metric-tile" GridPane.columnIndex="2">
            <Label text="平台" styleClass="metric-label"/>
            <Label fx:id="architectureLabel" text="--" styleClass="metric-value"/>
        </VBox>
    </GridPane>

    <TableView fx:id="resultTable" styleClass="environment-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="statusColumn" text="状态" prefWidth="90"/>
            <TableColumn fx:id="toolColumn" text="工具" prefWidth="140"/>
            <TableColumn fx:id="versionColumn" text="版本" prefWidth="240"/>
            <TableColumn fx:id="pathColumn" text="可执行文件 / 运行目录" prefWidth="320"/>
            <TableColumn fx:id="detailColumn" text="诊断" prefWidth="250"/>
        </columns>
    </TableView>
</VBox>

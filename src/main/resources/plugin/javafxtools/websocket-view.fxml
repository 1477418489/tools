<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.WebSocketController"
      spacing="12" prefWidth="1000" prefHeight="700" styleClass="tool-page">

    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <Label text="WebSocket 客户端" styleClass="page-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="wsStatusLabel" text="未连接" styleClass="status-badge, status-offline"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
        <TextField fx:id="wsUrlField" promptText="ws:// 或 wss://"
                   onAction="#handleWsConnect" HBox.hgrow="ALWAYS"/>
        <Button fx:id="wsConnectButton" text="连接" onAction="#handleWsConnect"
                styleClass="primary-button"/>
        <Button fx:id="wsDisconnectButton" text="断开" onAction="#handleWsDisconnect"
                styleClass="danger-button"/>
    </HBox>

    <VBox spacing="7" styleClass="surface" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" styleClass="section-header">
            <Label text="消息记录" styleClass="section-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="wsClearButton" text="清空" onAction="#handleWsClear"
                    styleClass="compact-button"/>
        </HBox>
        <TextArea fx:id="wsMessageArea" editable="false" wrapText="true"
                  VBox.vgrow="ALWAYS" styleClass="log-area"/>
    </VBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
        <TextField fx:id="wsMessageField" promptText="输入消息，按 Enter 发送"
                   HBox.hgrow="ALWAYS" onAction="#handleWsSend"/>
        <Button fx:id="wsSendButton" text="发送" onAction="#handleWsSend"
                styleClass="primary-button"/>
    </HBox>
</VBox>

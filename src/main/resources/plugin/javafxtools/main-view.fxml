<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import plugin.javafxtools.control.LogViewer?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.MainController"
      spacing="0" prefWidth="1240" prefHeight="800" styleClass="app-shell">

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="app-header">
        <StackPane styleClass="brand-icon-shell">
            <ImageView fitWidth="36" fitHeight="36" preserveRatio="true" smooth="true">
                <image><Image url="@../../favicon.png"/></image>
            </ImageView>
        </StackPane>
        <VBox spacing="0" alignment="CENTER_LEFT">
            <Label text="FxTools" styleClass="brand-title"/>
            <Label text="本地开发工作台" styleClass="brand-subtitle"/>
        </VBox>
        <Pane HBox.hgrow="ALWAYS"/>
        <HBox spacing="7" alignment="CENTER_LEFT" styleClass="runtime-pill">
            <Region styleClass="runtime-dot"/>
            <Label text="本地运行" styleClass="runtime-text"/>
        </HBox>
        <MenuButton text="设置" styleClass="settings-menu-button">
            <items>
                <CheckMenuItem fx:id="closeToTrayMenuItem" text="关闭到系统托盘"
                               onAction="#handleCloseToTraySetting"/>
                <CheckMenuItem fx:id="reminderSoundMenuItem" text="提醒时播放声音"
                               onAction="#handleReminderSoundSetting"/>
                <CheckMenuItem fx:id="startupMenuItem" text="随 Windows 登录启动"
                               onAction="#handleStartupSetting"/>
                <SeparatorMenuItem/>
                <MenuItem text="打开数据目录" onAction="#handleOpenDataDirectory"/>
                <MenuItem fx:id="exportBackupMenuItem" text="导出数据备份"
                          onAction="#handleExportDataBackup"/>
            </items>
        </MenuButton>
    </HBox>

    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
             styleClass="toolbox-tab-pane" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab fx:id="appLauncherTab" text="启动项"/>
            <Tab fx:id="httpRequestTab" text="HTTP 请求"/>
            <Tab fx:id="webSocketTab" text="WebSocket"/>
            <Tab fx:id="networkToolsTab" text="网络查询"/>
            <Tab fx:id="dataFormatTab" text="数据格式化"/>
            <Tab fx:id="strDataFormatTab" text="字符串处理"/>
            <Tab fx:id="jarLauncherTab" text="JAR 启动"/>
            <Tab fx:id="memoReminderTab" text="备忘提醒"/>
            <Tab fx:id="keepAliveTab" text="域名保活"/>
            <Tab fx:id="windowsPowerTab" text="电源计划"/>
        </tabs>
    </TabPane>

    <LogViewer fx:id="systemLogViewer" title="系统日志" windowTitle="系统日志"
               promptText="等待系统事件"/>
</VBox>

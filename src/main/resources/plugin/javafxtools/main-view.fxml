<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.MainController"
      spacing="0" prefWidth="1240" prefHeight="800" styleClass="app-shell">

    <HBox alignment="CENTER_LEFT" styleClass="app-header">
        <Label text="FxTools" styleClass="brand-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label text="本地运行" styleClass="status-badge, status-online"/>
    </HBox>

    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
             styleClass="toolbox-tab-pane" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="启动项">
                <fx:include fx:id="appLauncherTab" source="app-launcher-view.fxml"/>
            </Tab>
            <Tab text="HTTP 请求">
                <fx:include fx:id="httpRequestTab" source="http-request-view.fxml"/>
            </Tab>
            <Tab text="WebSocket">
                <fx:include fx:id="webSocketTab" source="websocket-view.fxml"/>
            </Tab>
            <Tab text="网络查询">
                <fx:include fx:id="networkToolsTab" source="network-tools-view.fxml"/>
            </Tab>
            <Tab text="数据格式化">
                <fx:include fx:id="dataFormatTab" source="data-format-view.fxml"/>
            </Tab>
            <Tab text="字符串处理">
                <fx:include fx:id="strDataFormatTab" source="strData-format-view.fxml"/>
            </Tab>
            <Tab text="JAR 启动">
                <fx:include fx:id="jarLauncherTab" source="jar-launcher-view.fxml"/>
            </Tab>
            <Tab text="备忘提醒">
                <fx:include fx:id="memoReminderTab" source="memo-reminder-view.fxml"/>
            </Tab>
            <Tab text="域名保活">
                <fx:include fx:id="keepAliveTab" source="keepalive-manager-view.fxml"/>
            </Tab>
        </tabs>
    </TabPane>

    <TitledPane fx:id="systemLogPane" text="系统日志" expanded="false" animated="false"
                collapsible="true" styleClass="system-log-pane">
        <content>
            <TextArea fx:id="centralLogArea" editable="false" prefHeight="150" styleClass="log-area"/>
        </content>
    </TitledPane>
</VBox>

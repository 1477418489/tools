<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import plugin.javafxtools.control.LogViewer?>

<HBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.MainController"
      prefWidth="1320" prefHeight="820" styleClass="app-shell">

    <VBox minWidth="208" prefWidth="208" maxWidth="208" styleClass="app-sidebar">
        <HBox spacing="11" alignment="CENTER_LEFT" styleClass="sidebar-brand">
            <StackPane styleClass="brand-icon-shell">
                <ImageView fitWidth="34" fitHeight="34" preserveRatio="true" smooth="true">
                    <image><Image url="@../../favicon.png"/></image>
                </ImageView>
            </StackPane>
            <VBox spacing="0" alignment="CENTER_LEFT">
                <Label text="FxTools" styleClass="brand-title"/>
                <Label text="LOCAL WORKSPACE" styleClass="brand-subtitle"/>
            </VBox>
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
            <content>
        <VBox spacing="16" styleClass="sidebar-navigation">
            <VBox spacing="4">
                <Label text="启动与运行" styleClass="nav-group-label"/>
                <ToggleButton fx:id="appLauncherNavButton" text="启动项" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-green">
                    <graphic><Label text="APP" styleClass="nav-code"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="jarLauncherNavButton" text="JAR 启动" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-green">
                    <graphic><Label text="JAR" styleClass="nav-code"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="windowsPowerNavButton" text="电源计划" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-blue">
                    <graphic><Label text="PWR" styleClass="nav-code"/></graphic>
                </ToggleButton>
            </VBox>

            <VBox spacing="4">
                <Label text="网络与接口" styleClass="nav-group-label"/>
                <ToggleButton fx:id="httpRequestNavButton" text="HTTP 请求" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-blue">
                    <graphic><Label text="HTTP" styleClass="nav-code"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="webSocketNavButton" text="WebSocket" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-violet">
                    <graphic><Label text="WS" styleClass="nav-code"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="networkToolsNavButton" text="网络诊断" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-amber">
                    <graphic><Label text="NET" styleClass="nav-code"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="networkQualityNavButton" text="网络质量" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-blue">
                    <graphic><Label text="NQM" styleClass="nav-code"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="keepAliveNavButton" text="域名保活" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-amber">
                    <graphic><Label text="DNS" styleClass="nav-code"/></graphic>
                </ToggleButton>
            </VBox>

            <VBox spacing="4">
                <Label text="系统与开发" styleClass="nav-group-label"/>
                <ToggleButton fx:id="processPortNavButton" text="进程与端口" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-green">
                    <graphic><Label text="PROC" styleClass="nav-code"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="devEnvironmentNavButton" text="环境体检" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-blue">
                    <graphic><Label text="DEV" styleClass="nav-code"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="fileAnalysisNavButton" text="文件分析" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-amber">
                    <graphic><Label text="FILE" styleClass="nav-code"/></graphic>
                </ToggleButton>
            </VBox>

            <VBox spacing="4">
                <Label text="数据与效率" styleClass="nav-group-label"/>
                <ToggleButton fx:id="dataFormatNavButton" text="数据格式化" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-blue">
                    <graphic><Label text="JSON" styleClass="nav-code"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="strDataFormatNavButton" text="字符串处理" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-violet">
                    <graphic><Label text="TEXT" styleClass="nav-code"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="base64NavButton" text="Base64 编解码" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-violet">
                    <graphic><Label text="B64" styleClass="nav-code"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="memoReminderNavButton" text="备忘提醒" maxWidth="Infinity"
                              contentDisplay="LEFT" graphicTextGap="10"
                              styleClass="sidebar-nav-button, nav-rose">
                    <graphic><Label text="TIME" styleClass="nav-code"/></graphic>
                </ToggleButton>
            </VBox>
        </VBox>
            </content>
        </ScrollPane>

        <VBox spacing="8" styleClass="sidebar-footer">
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="runtime-status">
                <Region styleClass="runtime-dot"/>
                <VBox spacing="0">
                    <Label text="本地服务" styleClass="runtime-title"/>
                    <Label text="运行正常" styleClass="runtime-text"/>
                </VBox>
            </HBox>
            <Label text="FxTools  ·  Windows" styleClass="build-label"/>
        </VBox>
    </VBox>

    <VBox styleClass="workspace-shell" HBox.hgrow="ALWAYS">
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="workspace-header">
            <HBox spacing="7" alignment="CENTER_LEFT" styleClass="workspace-breadcrumb">
                <Label text="工作台" styleClass="workspace-path"/>
                <Label text="/" styleClass="workspace-separator"/>
                <Label fx:id="activeSectionLabel" text="启动与运行" styleClass="workspace-path"/>
                <Label text="/" styleClass="workspace-separator"/>
                <Label fx:id="activeModuleLabel" text="启动项" styleClass="workspace-current"/>
            </HBox>
            <Pane HBox.hgrow="ALWAYS"/>
            <LogViewer fx:id="systemLogViewer" title="系统日志" windowTitle="系统日志"
                       promptText="等待系统事件"/>
            <MenuButton text="设置" styleClass="settings-menu-button">
                <items>
                    <CheckMenuItem fx:id="closeToTrayMenuItem" text="关闭到系统托盘"
                                   onAction="#handleCloseToTraySetting"/>
                    <CheckMenuItem fx:id="reminderSoundMenuItem" text="提醒时播放声音"
                                   onAction="#handleReminderSoundSetting"/>
                    <CheckMenuItem fx:id="startupMenuItem" text="随 Windows 登录启动"
                                   onAction="#handleStartupSetting"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="打开数据目录" onAction="#handleOpenDataDirectory"/>
                    <MenuItem fx:id="exportBackupMenuItem" text="导出数据备份"
                              onAction="#handleExportDataBackup"/>
                </items>
            </MenuButton>
        </HBox>

        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
                 styleClass="toolbox-tab-pane" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab fx:id="appLauncherTab" text="启动项"/>
                <Tab fx:id="httpRequestTab" text="HTTP 请求"/>
                <Tab fx:id="webSocketTab" text="WebSocket"/>
                <Tab fx:id="networkToolsTab" text="网络诊断"/>
                <Tab fx:id="networkQualityTab" text="网络质量"/>
                <Tab fx:id="processPortTab" text="进程与端口"/>
                <Tab fx:id="devEnvironmentTab" text="环境体检"/>
                <Tab fx:id="fileAnalysisTab" text="文件分析"/>
                <Tab fx:id="dataFormatTab" text="数据格式化"/>
                <Tab fx:id="strDataFormatTab" text="字符串处理"/>
                <Tab fx:id="base64Tab" text="Base64 编解码"/>
                <Tab fx:id="jarLauncherTab" text="JAR 启动"/>
                <Tab fx:id="memoReminderTab" text="备忘提醒"/>
                <Tab fx:id="keepAliveTab" text="域名保活"/>
                <Tab fx:id="windowsPowerTab" text="电源计划"/>
            </tabs>
        </TabPane>
    </VBox>
</HBox>

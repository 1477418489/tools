<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.NetworkToolsController"
      spacing="12" prefWidth="1000" prefHeight="700" styleClass="tool-page, accent-amber">

    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <Label text="网络查询" styleClass="page-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="lookupStatusLabel" text="就绪" styleClass="status-badge, status-offline"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
        <TextField fx:id="hostField" promptText="输入域名或 IP 地址，按 Enter 查询"
                   onAction="#handleLookup" HBox.hgrow="ALWAYS"/>
        <Button fx:id="lookupButton" text="查询" onAction="#handleLookup" styleClass="primary-button"/>
        <Button fx:id="clearButton" text="清空" onAction="#handleClear"/>
    </HBox>

    <VBox spacing="7" styleClass="surface" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" styleClass="section-header">
            <Label text="查询结果" styleClass="section-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="copyButton" text="复制结果" onAction="#handleCopyResult"
                    styleClass="compact-button"/>
        </HBox>
        <TextArea fx:id="lookupResultArea" editable="false" VBox.vgrow="ALWAYS" styleClass="log-area"/>
    </VBox>
</VBox>

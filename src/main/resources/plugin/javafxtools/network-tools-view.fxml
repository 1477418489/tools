<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.NetworkToolsController"
      spacing="12" prefWidth="1000" prefHeight="700" styleClass="tool-page, accent-amber">

    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <Label text="网络诊断" styleClass="page-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="lookupStatusLabel" text="就绪" styleClass="status-badge, status-offline"/>
    </HBox>

    <VBox spacing="9" styleClass="toolbar, network-command-bar">
        <HBox spacing="10" alignment="BOTTOM_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="域名 / IP / URL" styleClass="field-label"/>
                <TextField fx:id="hostField"
                           promptText="example.com、8.8.8.8、[::1]:8080 或 https://example.com"
                           onAction="#handleCheckAll"/>
            </VBox>
            <VBox spacing="4">
                <Label text="TCP 端口" styleClass="field-label"/>
                <ComboBox fx:id="portComboBox" editable="true" prefWidth="138"
                          promptText="可选 / 自动"/>
            </VBox>
            <VBox spacing="4">
                <Label text="检测超时" styleClass="field-label"/>
                <ComboBox fx:id="timeoutComboBox" prefWidth="132"/>
            </VBox>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="checkAllButton" text="综合检测" onAction="#handleCheckAll"
                    styleClass="primary-button"/>
            <Button fx:id="resolveButton" text="DNS / IP" onAction="#handleResolve"/>
            <Button fx:id="portCheckButton" text="端口检查" onAction="#handlePortCheck"/>
            <Button fx:id="ipLookupButton" text="IP 信息" onAction="#handleIpLookup"/>
            <Button fx:id="publicIpButton" text="公网 IP" onAction="#handlePublicIpLookup"/>
            <Button fx:id="cancelButton" text="取消" onAction="#handleCancel"
                    styleClass="danger-button"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="clearButton" text="清空" onAction="#handleClear"/>
        </HBox>
    </VBox>

    <HBox spacing="10" styleClass="network-summary-row">
        <VBox spacing="3" maxWidth="Infinity" styleClass="network-summary-card, network-summary-target"
              HBox.hgrow="ALWAYS">
            <Label text="目标" styleClass="network-summary-label"/>
            <Label fx:id="targetSummaryLabel" text="等待输入" maxWidth="Infinity"
                   textOverrun="ELLIPSIS" styleClass="network-summary-value"/>
            <Label fx:id="targetMetaLabel" text="域名、IPv4、IPv6 或 URL" maxWidth="Infinity"
                   textOverrun="ELLIPSIS" styleClass="network-summary-meta"/>
        </VBox>
        <VBox fx:id="dnsSummaryCard" spacing="3" maxWidth="Infinity"
              styleClass="network-summary-card" HBox.hgrow="ALWAYS">
            <Label text="DNS / IP" styleClass="network-summary-label"/>
            <Label fx:id="dnsSummaryLabel" text="未检测" maxWidth="Infinity"
                   textOverrun="ELLIPSIS" styleClass="network-summary-value"/>
            <Label fx:id="dnsMetaLabel" text="等待解析" maxWidth="Infinity"
                   textOverrun="ELLIPSIS" styleClass="network-summary-meta"/>
        </VBox>
        <VBox fx:id="reachabilitySummaryCard" spacing="3" maxWidth="Infinity"
              styleClass="network-summary-card" HBox.hgrow="ALWAYS">
            <Label text="主机响应" styleClass="network-summary-label"/>
            <Label fx:id="reachabilitySummaryLabel" text="未检测" maxWidth="Infinity"
                   textOverrun="ELLIPSIS" styleClass="network-summary-value"/>
            <Label fx:id="reachabilityMetaLabel" text="系统探测或 TCP 结果" maxWidth="Infinity"
                   textOverrun="ELLIPSIS" styleClass="network-summary-meta"/>
        </VBox>
        <VBox fx:id="portSummaryCard" spacing="3" maxWidth="Infinity"
              styleClass="network-summary-card" HBox.hgrow="ALWAYS">
            <Label text="TCP 端口" styleClass="network-summary-label"/>
            <Label fx:id="portSummaryLabel" text="未检测" maxWidth="Infinity"
                   textOverrun="ELLIPSIS" styleClass="network-summary-value"/>
            <Label fx:id="portMetaLabel" text="可手动填写或从 URL 推断" maxWidth="Infinity"
                   textOverrun="ELLIPSIS" styleClass="network-summary-meta"/>
        </VBox>
    </HBox>

    <SplitPane dividerPositions="0.42" VBox.vgrow="ALWAYS"
               styleClass="network-result-workspace">
        <items>
            <VBox spacing="8" minWidth="330" styleClass="surface">
                <HBox alignment="CENTER_LEFT" styleClass="section-header">
                    <Label text="解析地址" styleClass="section-title"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label fx:id="addressCountLabel" text="0 个地址" styleClass="status-muted"/>
                </HBox>
                <ListView fx:id="addressListView" VBox.vgrow="ALWAYS"
                          styleClass="network-address-list"/>
            </VBox>

            <VBox spacing="8" minWidth="420" styleClass="surface">
                <HBox alignment="CENTER_LEFT" styleClass="section-header">
                    <Label text="结果详情" styleClass="section-title"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button fx:id="copyButton" text="复制详情" onAction="#handleCopyResult"
                            styleClass="compact-button"/>
                </HBox>
                <TabPane fx:id="resultTabPane" tabClosingPolicy="UNAVAILABLE"
                         VBox.vgrow="ALWAYS" styleClass="editor-tab-pane, network-result-tabs">
                    <tabs>
                        <Tab fx:id="diagnosticDetailTab" text="诊断详情">
                            <TextArea fx:id="detailArea" editable="false" wrapText="true"
                                      styleClass="code-area"/>
                        </Tab>
                        <Tab fx:id="ipInfoTab" text="IP 信息">
                            <ScrollPane fitToWidth="true" styleClass="ip-information-scroll">
                                <content>
                                    <VBox spacing="12" styleClass="ip-information-pane">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="IP 归属与网络信息" styleClass="section-title"/>
                                            <Pane HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="ipInformationStatusLabel" text="未查询"
                                                   styleClass="status-badge, status-offline"/>
                                        </HBox>
                                        <GridPane hgap="14" vgap="10" styleClass="ip-information-grid">
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="82" prefWidth="82"
                                                                   halignment="RIGHT"/>
                                                <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                                            </columnConstraints>
                                            <Label text="IP 地址" styleClass="field-label"
                                                   GridPane.rowIndex="0"/>
                                            <Label fx:id="ipAddressValueLabel" text="--" maxWidth="Infinity"
                                                   wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                                   styleClass="ip-information-value"/>
                                            <Label text="类型" styleClass="field-label"
                                                   GridPane.rowIndex="1"/>
                                            <Label fx:id="ipTypeValueLabel" text="--" maxWidth="Infinity"
                                                   wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                                   styleClass="ip-information-value"/>
                                            <Label text="地址范围" styleClass="field-label"
                                                   GridPane.rowIndex="2"/>
                                            <Label fx:id="ipScopeValueLabel" text="--" maxWidth="Infinity"
                                                   wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                                   styleClass="ip-information-value"/>
                                            <Label text="位置" styleClass="field-label"
                                                   GridPane.rowIndex="3"/>
                                            <Label fx:id="ipLocationValueLabel" text="--" maxWidth="Infinity"
                                                   wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3"
                                                   styleClass="ip-information-value"/>
                                            <Label text="网络 / ASN" styleClass="field-label"
                                                   GridPane.rowIndex="4"/>
                                            <Label fx:id="ipNetworkValueLabel" text="--" maxWidth="Infinity"
                                                   wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4"
                                                   styleClass="ip-information-value"/>
                                            <Label text="时区" styleClass="field-label"
                                                   GridPane.rowIndex="5"/>
                                            <Label fx:id="ipTimezoneValueLabel" text="--" maxWidth="Infinity"
                                                   wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5"
                                                   styleClass="ip-information-value"/>
                                            <Label text="坐标" styleClass="field-label"
                                                   GridPane.rowIndex="6"/>
                                            <Label fx:id="ipCoordinatesValueLabel" text="--" maxWidth="Infinity"
                                                   wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6"
                                                   styleClass="ip-information-value"/>
                                            <Label text="数据来源" styleClass="field-label"
                                                   GridPane.rowIndex="7"/>
                                            <Label fx:id="ipDataSourceValueLabel" text="--" maxWidth="Infinity"
                                                   wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="7"
                                                   styleClass="ip-information-value"/>
                                        </GridPane>
                                    </VBox>
                                </content>
                            </ScrollPane>
                        </Tab>
                    </tabs>
                </TabPane>
            </VBox>
        </items>
    </SplitPane>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.AppLauncherController"
      spacing="12" prefWidth="1000" prefHeight="700" styleClass="tool-page">

    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <Label text="应用启动项" styleClass="page-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="appCountLabel" text="0 个应用" styleClass="status-badge, status-offline"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
        <TextField fx:id="appPathField" promptText="输入应用路径或选择可执行文件"
                   onAction="#handleAdd" HBox.hgrow="ALWAYS"/>
        <Button fx:id="browseButton" text="浏览" onAction="#handleBrowse"/>
        <Button fx:id="addButton" text="添加应用" onAction="#handleAdd" styleClass="primary-button"/>
    </HBox>

    <VBox spacing="8" styleClass="surface" VBox.vgrow="ALWAYS">
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="section-header">
            <Label text="应用列表" styleClass="section-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="launchSingleButton" text="启动选中" onAction="#handleLaunchSingle"
                    styleClass="success-button"/>
            <Button fx:id="launchAllButton" text="启动全部" onAction="#handleLaunchAll"
                    styleClass="success-button"/>
            <Button fx:id="killProcessButton" text="结束进程" onAction="#handleKillProcess"
                    styleClass="danger-button"/>
        </HBox>

        <ListView fx:id="appListView" VBox.vgrow="ALWAYS" styleClass="enhanced-list-view">
            <placeholder>
                <VBox alignment="CENTER" styleClass="empty-state">
                    <Label text="暂无应用" styleClass="sub-title"/>
                </VBox>
            </placeholder>
        </ListView>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="moveUpButton" text="↑" onAction="#handleMoveUp"
                    minWidth="34" maxWidth="34" styleClass="icon-button">
                <tooltip><Tooltip text="上移"/></tooltip>
            </Button>
            <Button fx:id="moveDownButton" text="↓" onAction="#handleMoveDown"
                    minWidth="34" maxWidth="34" styleClass="icon-button">
                <tooltip><Tooltip text="下移"/></tooltip>
            </Button>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="refreshStatusButton" text="↻" onAction="#handleRefreshStatus"
                    minWidth="34" maxWidth="34" styleClass="icon-button">
                <tooltip><Tooltip text="刷新运行状态"/></tooltip>
            </Button>
            <Button fx:id="removeButton" text="移除选中" onAction="#handleRemove"
                    styleClass="compact-button"/>
            <Button fx:id="clearButton" text="清空列表" onAction="#handleClear"
                    styleClass="danger-button, compact-button"/>
        </HBox>
    </VBox>

    <VBox spacing="7" minHeight="120" prefHeight="165" styleClass="log-panel">
        <HBox alignment="CENTER_LEFT" styleClass="section-header">
            <Label text="执行日志" styleClass="section-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="清空" onAction="#handleClearLog" styleClass="compact-button"/>
        </HBox>
        <TextArea fx:id="logArea" editable="false" VBox.vgrow="ALWAYS" styleClass="log-area"/>
    </VBox>
</VBox>

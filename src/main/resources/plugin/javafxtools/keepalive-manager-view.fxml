<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import plugin.javafxtools.control.LogViewer?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.KeepAliveManagerController"
      spacing="12" prefWidth="1000" prefHeight="700" styleClass="tool-page, accent-amber">

    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <Label text="域名保活" styleClass="page-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="configCountLabel" text="0 条配置" styleClass="status-badge, status-offline"/>
    </HBox>

    <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS">
        <items>
            <VBox spacing="7" styleClass="surface">
                <Label text="域名配置" styleClass="section-title"/>
                <TableView fx:id="configTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="domainColumn" text="域名" prefWidth="210"/>
                        <TableColumn fx:id="enabledColumn" text="状态" prefWidth="60"/>
                        <TableColumn fx:id="methodColumn" text="方式" prefWidth="80"/>
                        <TableColumn fx:id="intervalColumn" text="间隔" prefWidth="135"/>
                        <TableColumn fx:id="unitColumn" text="单位" prefWidth="65"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" styleClass="empty-state">
                            <Label text="暂无配置" styleClass="sub-title"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

            <VBox spacing="12" styleClass="surface">
                <Label text="配置编辑器" styleClass="section-title"/>

                <VBox spacing="4">
                    <Label text="域名地址" styleClass="field-label"/>
                    <TextField fx:id="domainField" promptText="https://example.com" onAction="#handleAdd"/>
                </VBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <CheckBox fx:id="enabledCheckBox" text="启用保活"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label text="保活方式" styleClass="field-label"/>
                    <ComboBox fx:id="methodComboBox" prefWidth="120"/>
                </HBox>

                <VBox spacing="4">
                    <Label text="访问间隔" styleClass="field-label"/>
                    <HBox spacing="7" alignment="CENTER_LEFT">
                        <Spinner fx:id="minIntervalSpinner" prefWidth="82"/>
                        <Label text="至"/>
                        <Spinner fx:id="maxIntervalSpinner" prefWidth="82"/>
                        <ComboBox fx:id="unitComboBox" prefWidth="100"/>
                    </HBox>
                </VBox>

                <Separator/>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="addButton" text="添加" onAction="#handleAdd" styleClass="primary-button"/>
                    <Button fx:id="updateButton" text="更新选中" onAction="#handleUpdate"/>
                    <Button fx:id="removeButton" text="删除选中" onAction="#handleRemove"
                            styleClass="danger-button"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button fx:id="saveButton" text="保存全部" onAction="#handleSave"/>
                </HBox>
            </VBox>
        </items>
    </SplitPane>

    <LogViewer fx:id="logViewer" title="执行日志" promptText="等待操作" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="status-bar">
        <Label fx:id="statusLabel" text="就绪" styleClass="status-text"/>
        <Separator orientation="VERTICAL"/>
        <Label fx:id="activeCountLabel" text="活跃: 0" styleClass="status-active"/>
        <Separator orientation="VERTICAL"/>
        <Label fx:id="lastUpdateLabel" text="最后更新: --" styleClass="status-muted"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <ProgressIndicator fx:id="progressIndicator" visible="false" managed="false"
                           prefWidth="16" prefHeight="16"/>
    </HBox>
</VBox>

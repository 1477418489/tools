<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import plugin.javafxtools.control.LogViewer?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.JarLauncherController"
      spacing="12" prefWidth="1000" prefHeight="700" styleClass="tool-page, accent-green">

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="page-header">
        <Label text="JAR 应用启动" styleClass="page-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusRefreshTimeLabel" text="尚未更新" styleClass="status-muted"/>
        <Button fx:id="refreshProjectStatusButton" text="↻" onAction="#refreshProjectStatuses"
                minWidth="34" maxWidth="34" styleClass="icon-button">
            <tooltip><Tooltip text="刷新全部项目状态"/></tooltip>
        </Button>
        <Label fx:id="projectOverviewLabel" text="暂无项目"
               styleClass="status-badge, status-offline"/>
        <Label fx:id="projectStatusLabel" text="未选择项目" styleClass="status-badge, status-offline"/>
    </HBox>

    <SplitPane dividerPositions="0.34" VBox.vgrow="ALWAYS" styleClass="jar-launcher-workspace">
        <items>
            <VBox spacing="9" minWidth="260" styleClass="surface">
                <HBox alignment="CENTER_LEFT" styleClass="section-header">
                    <Label text="项目列表" styleClass="section-title"/>
                </HBox>

                <ListView fx:id="projectListView" VBox.vgrow="ALWAYS"
                          styleClass="jar-project-list"/>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="addProjectButton" text="添加" onAction="#handleAddProject"
                            styleClass="primary-button"/>
                    <Button fx:id="editProjectButton" text="编辑" onAction="#handleEditProject"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button fx:id="deleteProjectButton" text="删除" onAction="#handleDeleteProject"
                            styleClass="danger-button"/>
                </HBox>
            </VBox>

            <VBox spacing="14" minWidth="430" styleClass="surface">
                <Label text="启动配置" styleClass="section-title"/>

                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="运行端口" styleClass="field-label"/>
                        <TextField fx:id="portField" promptText="默认端口"
                                   onAction="#handleLaunchAction"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="运行环境" styleClass="field-label"/>
                        <TextField fx:id="profileField" promptText="默认环境"/>
                    </VBox>
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="launchButton" text="启动应用" onAction="#handleLaunchAction"
                            styleClass="success-button"/>
                    <Button fx:id="stopButton" text="停止应用" onAction="#handleStopAction"
                            styleClass="danger-button"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="copyButton" text="复制部署文件" onAction="#handleCopyAction"/>
                    <Button fx:id="openDirectoryButton" text="打开目录"
                            onAction="#handleOpenTargetDirectory"/>
                    <Button fx:id="openLogButton" text="打开日志"
                            onAction="#handleOpenCurrentLog"/>
                </HBox>

                <Separator/>
                <Label text="端口工具" styleClass="section-title"/>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="portNumField" promptText="输入端口" HBox.hgrow="ALWAYS"
                               onAction="#queryPort"/>
                    <Button fx:id="portQueryButton" text="查询占用" onAction="#queryPort"/>
                </HBox>

                <Pane VBox.vgrow="ALWAYS"/>
                <ProgressBar fx:id="progressBar" visible="false" managed="false"
                             maxWidth="Infinity"/>
            </VBox>
        </items>
    </SplitPane>

    <LogViewer fx:id="logViewer" title="执行日志" promptText="等待操作"
               inlineContent="true" VBox.vgrow="ALWAYS"/>
</VBox>

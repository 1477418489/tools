<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.HttpRequestController"
      spacing="12" prefWidth="1000" prefHeight="750" styleClass="tool-page">

    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <Label text="HTTP 请求调度" styleClass="page-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="schedulerStatusLabel" text="已停止" styleClass="status-badge, status-offline"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
        <ComboBox fx:id="methodComboBox" prefWidth="105"/>
        <TextField fx:id="urlField" promptText="https://example.com/api" HBox.hgrow="ALWAYS"/>
        <Button fx:id="startButton" text="启动调度" onAction="#handleStartButton"
                styleClass="success-button"/>
        <Button fx:id="stopButton" text="停止" onAction="#handleStopButton"
                styleClass="danger-button"/>
    </HBox>

    <VBox spacing="9" styleClass="surface">
        <HBox fx:id="schedulerSettingsPane" spacing="10" alignment="BOTTOM_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="开始时间" styleClass="field-label"/>
                <HBox spacing="6">
                    <TextField fx:id="startTimeField" promptText="yyyy-MM-dd HH:mm:ss" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="nowButton" text="现在" onAction="#handleNowButton"/>
                </HBox>
            </VBox>
            <VBox spacing="4">
                <Label text="间隔（秒）" styleClass="field-label"/>
                <TextField fx:id="intervalField" text="60" prefWidth="95"/>
            </VBox>
            <VBox spacing="4">
                <Label text="连接超时（ms）" styleClass="field-label"/>
                <TextField fx:id="connectTimeoutField" text="5000" prefWidth="115"/>
            </VBox>
            <VBox spacing="4">
                <Label text="读取超时（ms）" styleClass="field-label"/>
                <TextField fx:id="readTimeoutField" text="10000" prefWidth="115"/>
            </VBox>
            <VBox spacing="4">
                <Label text="响应显示" styleClass="field-label"/>
                <ComboBox fx:id="responseFormatComboBox" prefWidth="125"/>
            </VBox>
        </HBox>

        <Separator/>

        <HBox fx:id="templatePane" spacing="8" alignment="CENTER_LEFT">
            <Label text="请求模板" styleClass="field-label"/>
            <ComboBox fx:id="templateComboBox" editable="true" promptText="模板名称"
                      prefWidth="220" HBox.hgrow="ALWAYS"/>
            <Button text="保存" onAction="#handleSaveTemplate"/>
            <Button text="载入" onAction="#handleLoadTemplate"/>
            <Button text="删除" onAction="#handleDeleteTemplate" styleClass="danger-button"/>
        </HBox>
    </VBox>

    <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
        <items>
            <VBox spacing="7" styleClass="surface">
                <Label text="请求内容" styleClass="section-title"/>
                <TabPane fx:id="requestEditorPane" tabClosingPolicy="UNAVAILABLE"
                         styleClass="editor-tab-pane" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="参数 / 请求体">
                            <TextArea fx:id="paramsArea" styleClass="code-area"/>
                        </Tab>
                        <Tab text="请求头">
                            <TextArea fx:id="headersArea" styleClass="code-area"/>
                        </Tab>
                    </tabs>
                </TabPane>
            </VBox>

            <VBox spacing="7" styleClass="log-panel">
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="section-header">
                    <Label text="响应与执行日志" styleClass="section-title"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button fx:id="formatButton" text="美化响应" onAction="#handleFormatButton"
                            styleClass="compact-button"/>
                    <Button text="清空" onAction="#handleClearLog" styleClass="compact-button"/>
                </HBox>
                <TextArea fx:id="logArea" editable="false" VBox.vgrow="ALWAYS" styleClass="log-area"/>
            </VBox>
        </items>
    </SplitPane>
</VBox>

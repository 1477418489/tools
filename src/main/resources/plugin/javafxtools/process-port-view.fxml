<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.ProcessPortController"
      spacing="12" styleClass="tool-page, accent-green">
    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <Label text="进程与端口中心" styleClass="page-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="准备读取" styleClass="status-badge, status-offline"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar-card">
        <Label text="筛选" styleClass="field-label"/>
        <TextField fx:id="filterField" promptText="进程名、PID、用户、命令或端口"
                   maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button text="清除" onAction="#handleClearFilter" styleClass="secondary-button"/>
        <Separator orientation="VERTICAL"/>
        <Button fx:id="refreshButton" text="刷新快照" onAction="#handleRefresh"
                styleClass="primary-button"/>
        <Button fx:id="copyButton" text="复制详情" onAction="#handleCopySelected"/>
        <Button fx:id="terminateButton" text="终止进程" onAction="#handleTerminateSelected"
                styleClass="danger-button"/>
    </HBox>

    <GridPane hgap="10" styleClass="metric-strip">
        <columnConstraints>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
        </columnConstraints>
        <VBox spacing="3" styleClass="surface, metric-tile" GridPane.columnIndex="0">
            <Label text="进程" styleClass="metric-label"/>
            <Label fx:id="processCountLabel" text="--" styleClass="metric-value"/>
        </VBox>
        <VBox spacing="3" styleClass="surface, metric-tile" GridPane.columnIndex="1">
            <Label text="工作集总量" styleClass="metric-label"/>
            <Label fx:id="memoryTotalLabel" text="--" styleClass="metric-value"/>
        </VBox>
        <VBox spacing="3" styleClass="surface, metric-tile" GridPane.columnIndex="2">
            <Label text="TCP 监听" styleClass="metric-label"/>
            <Label fx:id="listenerCountLabel" text="--" styleClass="metric-value"/>
        </VBox>
        <VBox spacing="3" styleClass="surface, metric-tile" GridPane.columnIndex="3">
            <Label text="快照时间" styleClass="metric-label"/>
            <Label fx:id="capturedAtLabel" text="--" styleClass="metric-value"/>
        </VBox>
    </GridPane>

    <TabPane fx:id="resultTabPane" tabClosingPolicy="UNAVAILABLE"
             styleClass="workspace-tabs, process-port-tabs" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="进程">
                <TableView fx:id="processTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="processNameColumn" text="进程" prefWidth="150"/>
                        <TableColumn fx:id="processPidColumn" text="PID" prefWidth="76"/>
                        <TableColumn fx:id="processMemoryColumn" text="内存" prefWidth="92"/>
                        <TableColumn fx:id="processCpuColumn" text="CPU 时间" prefWidth="92"/>
                        <TableColumn fx:id="processPortsColumn" text="监听端口" prefWidth="120"/>
                        <TableColumn fx:id="processUserColumn" text="用户" prefWidth="140"/>
                        <TableColumn fx:id="processCommandColumn" text="命令行" prefWidth="360"/>
                    </columns>
                </TableView>
            </Tab>
            <Tab text="TCP 监听端口">
                <TableView fx:id="portTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="portNumberColumn" text="端口" prefWidth="110"/>
                        <TableColumn fx:id="portAddressColumn" text="监听地址" prefWidth="260"/>
                        <TableColumn fx:id="portPidColumn" text="PID" prefWidth="120"/>
                        <TableColumn fx:id="portProcessColumn" text="进程" prefWidth="300"/>
                    </columns>
                </TableView>
            </Tab>
        </tabs>
    </TabPane>
</VBox>

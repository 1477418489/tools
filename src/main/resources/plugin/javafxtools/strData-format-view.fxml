<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="plugin.javafxtools.controller.StrDataFormatController"
      spacing="12" prefWidth="1000" prefHeight="700" styleClass="tool-page">

    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <Label text="字符串处理" styleClass="page-title"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="等待输入" maxWidth="460" textOverrun="ELLIPSIS"
               styleClass="status-text"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="toolbar">
        <Label text="处理方式" styleClass="field-label"/>
        <ComboBox fx:id="formatTypeComboBox" prefWidth="150"/>
        <Button fx:id="formatButton" text="执行" onAction="#handleFormat" styleClass="primary-button"/>
        <Button fx:id="copyButton" text="复制结果" onAction="#handleCopyResult"/>
        <Button fx:id="clearButton" text="清空" onAction="#handleClear"/>
        <Pane HBox.hgrow="ALWAYS"/>
    </HBox>

    <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
        <items>
            <VBox spacing="7" styleClass="surface">
                <Label text="原始文本" styleClass="section-title"/>
                <TextArea fx:id="rawDataArea" wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>
            <VBox spacing="7" styleClass="surface">
                <Label text="处理结果" styleClass="section-title"/>
                <TextArea fx:id="formattedDataArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>
        </items>
    </SplitPane>
</VBox>

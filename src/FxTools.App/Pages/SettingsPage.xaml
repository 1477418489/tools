<Page
    x:Class="FxTools.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="12" MaxWidth="920" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置" />
                <TextBlock Foreground="{ThemeResource AppMutedBrush}" Text="应用行为与本地数据" />
            </StackPanel>

            <Border Style="{StaticResource SurfaceBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="桌面集成" />
                    <ToggleSwitch x:Name="CloseToTrayToggle" Header="关闭到系统托盘"
                                  Toggled="Setting_Toggled" />
                    <ToggleSwitch x:Name="StartWithWindowsToggle" Header="随 Windows 登录启动"
                                  Toggled="Setting_Toggled" />
                    <ToggleSwitch x:Name="ReminderSoundToggle" Header="提醒提示音"
                                  Toggled="Setting_Toggled" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="应用数据" />
                    <TextBox x:Name="DataPathBox" Grid.Row="1" Header="数据目录" IsReadOnly="True" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button Click="OpenDataFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="打开数据目录" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BackupButton" Click="Backup_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="Download" />
                                <TextBlock Text="导出 ZIP 备份" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Foreground="{ThemeResource AppMutedBrush}" Text="设置已就绪" />
        </StackPanel>
    </ScrollViewer>
</Page>

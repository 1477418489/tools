<Page
    x:Class="FxTools.App.Pages.WebSocketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Unloaded="Page_Unloaded">
    <Grid Padding="28" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="WebSocket" />
            <TextBlock Foreground="{ThemeResource AppMutedBrush}" Text="连接服务、发送文本，并查看受限的双向消息历史。" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="UrlBox" Header="地址" PlaceholderText="wss://echo.websocket.events" />
            <Button x:Name="ConnectButton" Grid.Column="1" VerticalAlignment="Bottom" Click="Connect_Click">
                <StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Link" /><TextBlock Text="连接" /></StackPanel>
            </Button>
            <Button x:Name="DisconnectButton" Grid.Column="2" VerticalAlignment="Bottom" Click="Disconnect_Click"
                    IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="DisconnectDrive" /><TextBlock Text="断开" /></StackPanel></Button>
            <Button Grid.Column="3" VerticalAlignment="Bottom" Click="Clear_Click" ToolTipService.ToolTip="清空历史"><SymbolIcon Symbol="Delete" /></Button>
        </Grid>
        <TextBox x:Name="HeadersBox" Grid.Row="2" Header="连接请求头（可选，每行 名称: 值）"
                 MinHeight="66" AcceptsReturn="True" TextWrapping="NoWrap" Style="{StaticResource MonospaceTextBoxStyle}" />
        <ListView x:Name="MessageList" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="75" /><ColumnDefinition Width="65" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource AppMutedBrush}" Text="{Binding Time}" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Kind}" />
                        <TextBlock Grid.Column="2" FontFamily="Cascadia Mono,Consolas" Text="{Binding Text}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="MessageBox" Header="发送消息" AcceptsReturn="True" MinHeight="70"
                     PlaceholderText="输入文本消息" Style="{StaticResource MonospaceTextBoxStyle}" />
            <Button x:Name="SendButton" Grid.Column="1" VerticalAlignment="Bottom" Click="Send_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Send" /><TextBlock Text="发送" /></StackPanel>
            </Button>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
            <ProgressRing x:Name="Progress" Width="18" Height="18" IsActive="False" />
            <TextBlock x:Name="StatusText" Foreground="{ThemeResource AppMutedBrush}" Text="未连接" />
        </StackPanel>
    </Grid>
</Page>

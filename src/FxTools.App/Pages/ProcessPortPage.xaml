<Page
    x:Class="FxTools.App.Pages.ProcessPortPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="28" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="进程与端口" />
                <TextBlock Foreground="{ThemeResource AppMutedBrush}"
                           Text="使用 Windows IP Helper API 获取端口与 PID 的实时映射。" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Name="RefreshButton" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton" Click="Copy_Click" IsEnabled="False" ToolTipService.ToolTip="复制所选详情">
                    <SymbolIcon Symbol="Copy" />
                </Button>
                <Button x:Name="TerminateButton" Click="Terminate_Click" IsEnabled="False"
                        ToolTipService.ToolTip="终止所选进程">
                    <SymbolIcon Symbol="Stop" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" Header="筛选" PlaceholderText="进程名、PID、端口或地址"
                     TextChanged="FilterBox_TextChanged" />
            <ComboBox x:Name="ProtocolBox" Grid.Column="1" Header="协议" SelectedIndex="0"
                      SelectionChanged="ProtocolBox_SelectionChanged" />
            <TextBlock x:Name="CountText" Grid.Column="3" VerticalAlignment="Bottom"
                       Foreground="{ThemeResource AppMutedBrush}" Text="0 条" />
        </Grid>

        <Border Grid.Row="2" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="协议" />
                <TextBlock Grid.Column="1" Style="{StaticResource FieldLabelStyle}" Text="本地地址" />
                <TextBlock Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="端口" />
                <TextBlock Grid.Column="3" Style="{StaticResource FieldLabelStyle}" Text="PID" />
                <TextBlock Grid.Column="4" Style="{StaticResource FieldLabelStyle}" Text="进程" />
                <TextBlock Grid.Column="5" Style="{StaticResource FieldLabelStyle}" Text="远程地址" />
                <TextBlock Grid.Column="6" Style="{StaticResource FieldLabelStyle}" Text="状态" />
            </Grid>
        </Border>

        <ListView x:Name="EntryList" Grid.Row="3" SelectionMode="Single"
                  SelectionChanged="EntryList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,7" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Protocol}" />
                        <TextBlock Grid.Column="1" FontFamily="Cascadia Mono,Consolas" Text="{Binding LocalAddress}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding LocalPort}" />
                        <TextBlock Grid.Column="3" Text="{Binding ProcessId}" />
                        <TextBlock Grid.Column="4" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="5" FontFamily="Cascadia Mono,Consolas" Text="{Binding RemoteEndpoint}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="6" Text="{Binding State}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="Progress" Width="18" Height="18" IsActive="False" />
                <TextBlock x:Name="StatusText" Foreground="{ThemeResource AppMutedBrush}" Text="等待刷新" />
            </StackPanel>
            <TextBlock x:Name="SelectedText" HorizontalAlignment="Right"
                       Foreground="{ThemeResource AppMutedBrush}" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Page>

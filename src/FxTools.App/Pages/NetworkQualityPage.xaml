<Page
    x:Class="FxTools.App.Pages.NetworkQualityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="28" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource PageTitleStyle}" Text="网络质量" /><TextBlock Foreground="{ThemeResource AppMutedBrush}" Text="持续测试 HTTP、TCP、TLS 或 STUN，显示时延、抖动和可用率。" /></StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Name="StartButton" Click="Start_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Play" /><TextBlock Text="开始" /></StackPanel></Button>
                <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Stop" /><TextBlock Text="停止" /></StackPanel></Button>
                <Button Click="CopyReport_Click" ToolTipService.ToolTip="复制报告"><SymbolIcon Symbol="Copy" /></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="TargetBox" Header="监测目标" SelectionChanged="TargetBox_SelectionChanged" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="SaveTarget_Click" ToolTipService.ToolTip="保存当前目标"><SymbolIcon Symbol="Save" /></Button>
            <Button Grid.Column="2" VerticalAlignment="Bottom" Click="DeleteTarget_Click" ToolTipService.ToolTip="删除所选目标"><SymbolIcon Symbol="Delete" /></Button>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="ProtocolBox" Header="协议" SelectedIndex="0" />
            <TextBox x:Name="HostBox" Grid.Column="1" Header="主机" PlaceholderText="example.com" />
            <NumberBox x:Name="PortBox" Grid.Column="2" Header="端口" Value="443" Minimum="1" Maximum="65535" />
            <TextBox x:Name="PathBox" Grid.Column="3" Header="HTTP 路径" Text="/" />
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <NumberBox x:Name="IntervalBox" Header="间隔（秒）" Value="5" Minimum="1" Maximum="3600" />
            <NumberBox x:Name="TimeoutBox" Grid.Column="1" Header="超时（秒）" Value="5" Minimum="0.25" Maximum="30" />
            <CheckBox x:Name="ProxyCheck" Grid.Column="2" VerticalAlignment="Bottom" Content="HTTP 代理" />
            <TextBox x:Name="ProxyBox" Grid.Column="3" Header="代理地址" PlaceholderText="http://127.0.0.1:7890" />
        </Grid>
        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="14">
                <Border Style="{StaticResource SurfaceBorderStyle}"><StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="总体质量" /><TextBlock x:Name="QualityText" FontSize="24" FontWeight="SemiBold" Text="等待" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="可用率" /><TextBlock x:Name="AvailabilityText" Text="--" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="平均 / P95" /><TextBlock x:Name="AverageText" Text="--" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="峰值 / 抖动" /><TextBlock x:Name="JitterText" Text="--" />
                </StackPanel></Border>
            </StackPanel>
            <ListView x:Name="HistoryList" Grid.Column="1" SelectionMode="None">
                <ListView.ItemTemplate><DataTemplate><Grid Padding="6" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" /><TextBlock Grid.Column="1" Text="{Binding State}" /><TextBlock Grid.Column="2" Text="{Binding Elapsed}" /><TextBlock Grid.Column="3" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" /></Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8"><ProgressRing x:Name="Progress" Width="18" Height="18" IsActive="False" /><TextBlock x:Name="StatusText" Foreground="{ThemeResource AppMutedBrush}" Text="等待开始" /></StackPanel>
    </Grid>
</Page>

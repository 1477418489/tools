<Page
    x:Class="FxTools.App.Pages.Base64Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Base64 编解码" />
            <TextBlock Foreground="{ThemeResource AppMutedBrush}"
                       Text="支持标准、URL 安全和 MIME 变体，以及常用中文编码。" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="VariantBox" Header="编码变体" SelectedIndex="0" />
            <ComboBox x:Name="EncodingBox" Grid.Column="1" Header="字符编码" SelectedIndex="0" />
            <Button Grid.Column="2" VerticalAlignment="Bottom" Click="Encode_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <SymbolIcon Symbol="Forward" />
                    <TextBlock Text="编码" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" VerticalAlignment="Bottom" Click="Decode_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <SymbolIcon Symbol="Back" />
                    <TextBlock Text="解码" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                <Button Click="Paste_Click" ToolTipService.ToolTip="粘贴到输入">
                    <SymbolIcon Symbol="Paste" />
                </Button>
                <Button Click="Swap_Click" ToolTipService.ToolTip="交换输入和结果">
                    <SymbolIcon Symbol="Switch" />
                </Button>
                <Button Click="Copy_Click" ToolTipService.ToolTip="复制结果">
                    <SymbolIcon Symbol="Copy" />
                </Button>
                <Button Click="Clear_Click" ToolTipService.ToolTip="清空">
                    <SymbolIcon Symbol="Delete" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Header="输入" PlaceholderText="输入或粘贴文本"
                     AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource MonospaceTextBoxStyle}" TextChanged="InputBox_TextChanged" />
            <TextBox x:Name="OutputBox" Grid.Column="1" Header="结果" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource MonospaceTextBoxStyle}" />
        </Grid>

        <Grid Grid.Row="3">
            <TextBlock x:Name="StatusText" Foreground="{ThemeResource AppMutedBrush}" Text="等待输入" />
            <TextBlock x:Name="CountText" HorizontalAlignment="Right"
                       Foreground="{ThemeResource AppMutedBrush}" Text="0 / 1,000,000" />
        </Grid>
    </Grid>
</Page>

<Page
    x:Class="FxTools.App.Pages.DevEnvironmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="开发环境体检" />
                <TextBlock x:Name="ArchitectureText" Foreground="{ThemeResource AppMutedBrush}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Name="RefreshButton" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="重新检查" />
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton" Click="Copy_Click" IsEnabled="False" ToolTipService.ToolTip="复制体检报告">
                    <SymbolIcon Symbol="Copy" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="28">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="可用工具" />
                <TextBlock x:Name="AvailableText" FontSize="20" FontWeight="SemiBold" Text="--" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="核心问题" />
                <TextBlock x:Name="IssueText" FontSize="20" FontWeight="SemiBold" Text="--" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="状态" />
                <TextBlock Grid.Column="1" Style="{StaticResource FieldLabelStyle}" Text="工具" />
                <TextBlock Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="版本" />
                <TextBlock Grid.Column="3" Style="{StaticResource FieldLabelStyle}" Text="路径" />
                <TextBlock Grid.Column="4" Style="{StaticResource FieldLabelStyle}" Text="详情" />
            </Grid>
        </Border>

        <ListView x:Name="ResultList" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,7" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Status}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Version}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" FontFamily="Cascadia Mono,Consolas" FontSize="12"
                                   Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <ProgressRing x:Name="Progress" Width="18" Height="18" IsActive="False" />
            <TextBlock x:Name="StatusText" Foreground="{ThemeResource AppMutedBrush}" Text="等待检查" />
        </StackPanel>
    </Grid>
</Page>

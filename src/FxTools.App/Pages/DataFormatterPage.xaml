<Page
    x:Class="FxTools.App.Pages.DataFormatterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="数据格式化" />
            <TextBlock Foreground="{ThemeResource AppMutedBrush}" Text="安全解析并格式化 JSON 或 XML 数据。" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FormatBox" Header="格式" SelectedIndex="0" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="Format_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <SymbolIcon Symbol="Accept" />
                    <TextBlock Text="格式化" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" VerticalAlignment="Bottom" Click="Copy_Click" ToolTipService.ToolTip="复制结果">
                <SymbolIcon Symbol="Copy" />
            </Button>
            <Button Grid.Column="4" VerticalAlignment="Bottom" Click="Clear_Click" ToolTipService.ToolTip="清空">
                <SymbolIcon Symbol="Delete" />
            </Button>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Header="原始数据" PlaceholderText="粘贴 JSON 或 XML"
                     AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" Style="{StaticResource MonospaceTextBoxStyle}" />
            <TextBox x:Name="OutputBox" Grid.Column="1" Header="格式化结果" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" Style="{StaticResource MonospaceTextBoxStyle}" />
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="{ThemeResource AppMutedBrush}" Text="等待输入" />
    </Grid>
</Page>

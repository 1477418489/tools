<Page
    x:Class="FxTools.App.Pages.WindowsPowerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <Grid Padding="28" RowSpacing="16" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource PageTitleStyle}" Text="Windows 电源" /><TextBlock Foreground="{ThemeResource AppMutedBrush}" Text="执行或计划电源操作，管理唤醒任务，并查看只读硬件诊断。" /></StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="10"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="立即操作" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="Shutdown_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Stop" /><TextBlock Text="关机" /></StackPanel></Button><Button Click="Restart_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Refresh" /><TextBlock Text="重启" /></StackPanel></Button><Button Click="Hibernate_Click"><TextBlock Text="休眠" /></Button><Button Click="Sleep_Click"><TextBlock Text="睡眠" /></Button></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Spacing="10"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="当前任务" /><TextBlock x:Name="PowerTaskText" Text="电源计划: --" /><TextBlock x:Name="WakeTaskText" Text="唤醒计划: --" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Click="CancelPower_Click"><TextBlock Text="取消电源计划" /></Button><Button Click="CancelWake_Click"><TextBlock Text="取消唤醒计划" /></Button><Button Click="RefreshTasks_Click" ToolTipService.ToolTip="刷新任务状态"><SymbolIcon Symbol="Refresh" /></Button></StackPanel></StackPanel>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource SurfaceBorderStyle}"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><DatePicker x:Name="ScheduleDate" Header="日期" /><TimePicker x:Name="ScheduleTime" Grid.Column="1" Header="时间" ClockIdentifier="24HourClock" /><ComboBox x:Name="ActionBox" Grid.Column="2" Header="电源操作" SelectedIndex="0" /><Button Grid.Column="3" VerticalAlignment="Bottom" Click="SchedulePower_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Calendar" /><TextBlock Text="创建电源计划" /></StackPanel></Button><Button Grid.Column="4" VerticalAlignment="Bottom" Click="ScheduleWake_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Clock" /><TextBlock Text="创建唤醒计划" /></StackPanel></Button></Grid></Border>
            <Border Grid.Row="3" Style="{StaticResource SurfaceBorderStyle}"><StackPanel Spacing="10"><Grid><TextBlock Style="{StaticResource SectionTitleStyle}" Text="只读系统诊断" /><Button x:Name="InspectButton" HorizontalAlignment="Right" Click="Inspect_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Repair" /><TextBlock Text="重新检测" /></StackPanel></Button></Grid><Grid RowSpacing="10" ColumnSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="设备" /><TextBlock x:Name="DeviceText" Text="--" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="操作系统" /><TextBlock x:Name="OsText" Text="--" /></StackPanel><StackPanel Grid.Row="1"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="BIOS / 固件" /><TextBlock x:Name="BiosText" Text="--" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="供电" /><TextBlock x:Name="SupplyText" Text="--" /></StackPanel><TextBox x:Name="DiagnosticsBox" Grid.Row="2" Grid.ColumnSpan="2" Height="220" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Style="{StaticResource MonospaceTextBoxStyle}" /></Grid></StackPanel></Border>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8"><ProgressRing x:Name="Progress" Width="18" Height="18" IsActive="False" /><TextBlock x:Name="StatusText" Foreground="{ThemeResource AppMutedBrush}" Text="等待操作" /></StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

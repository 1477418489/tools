<Page
    x:Class="FxTools.App.Pages.LogMonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="28" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource PageTitleStyle}" Text="日志监控与自动响应" /><TextBlock Foreground="{ThemeResource AppMutedBrush}" Text="增量读取日志、匹配多条规则，并向明确选定的窗口安全发送输入。" /></StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Name="StartButton" Click="Start_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Play" /><TextBlock Text="开始监控" /></StackPanel></Button>
                <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Stop" /><TextBlock Text="停止" /></StackPanel></Button>
                <Button Click="Save_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Save" /><TextBlock Text="保存配置" /></StackPanel></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="LogPathBox" Header="日志文件" PlaceholderText="选择要持续读取的日志" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseLog_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="OpenFile" /><TextBlock Text="选择" /></StackPanel></Button>
        </Grid>
        <TabView Grid.Row="2" IsAddTabButtonVisible="False">
            <TabViewItem Header="监控结果" IsClosable="False">
                <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ListView x:Name="MatchList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="6" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="{ThemeResource AppMutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding Rule}" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{Binding Line}" FontFamily="Cascadia Mono,Consolas" TextTrimming="CharacterEllipsis" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                    <TextBox x:Name="EventLogBox" Grid.Row="1" Header="自动响应记录" Height="125" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Style="{StaticResource MonospaceTextBoxStyle}" />
                </Grid>
            </TabViewItem>
            <TabViewItem Header="触发规则" IsClosable="False">
                <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ListView x:Name="RuleList" SelectionMode="Single" SelectionChanged="RuleList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="7" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="55" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions><TextBlock Text="{Binding State}" /><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding Expression}" FontFamily="Cascadia Mono,Consolas" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding Mode}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                    <StackPanel Grid.Column="1" Spacing="10">
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox x:Name="RuleNameBox" Header="名称" /><TextBox x:Name="RuleExpressionBox" Grid.Column="1" Header="表达式" /></Grid>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox x:Name="RuleModeBox" Header="匹配方式" SelectedIndex="1" /><CheckBox x:Name="CaseSensitiveCheck" Grid.Column="1" Content="区分大小写" VerticalAlignment="Bottom" IsChecked="True" /><CheckBox x:Name="RuleEnabledCheck" Grid.Column="2" Content="启用" VerticalAlignment="Bottom" IsChecked="True" /></Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Click="NewRule_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Add" /><TextBlock Text="新建规则" /></StackPanel></Button><Button Click="ApplyRule_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Accept" /><TextBlock Text="应用规则" /></StackPanel></Button><Button Click="DeleteRule_Click" ToolTipService.ToolTip="删除规则"><SymbolIcon Symbol="Delete" /></Button></StackPanel>
                    </StackPanel>
                </Grid>
            </TabViewItem>
            <TabViewItem Header="自动响应" IsClosable="False">
                <ScrollViewer><Grid Padding="2" RowSpacing="12" ColumnSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="8"><CheckBox x:Name="AutomationEnabledCheck" Content="启用自动响应" /><TextBlock Style="{StaticResource FieldLabelStyle}" Text="触发规则（可多选）" /><ListView x:Name="TriggerRuleList" Height="155" SelectionMode="Multiple"><ListView.ItemTemplate><DataTemplate><TextBlock Padding="5" Text="{Binding Display}" /></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="WindowBox" Header="目标窗口（PID + 完整标题）" DisplayMemberPath="DisplayName" /><Button Grid.Column="1" VerticalAlignment="Bottom" Click="RefreshWindows_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Refresh" /><TextBlock Text="读取窗口" /></StackPanel></Button></Grid><TextBox x:Name="InputTextBox" Header="自定义输入文本" Text="继续" MaxLength="4096" /><StackPanel Orientation="Horizontal" Spacing="18"><CheckBox x:Name="TypeTextCheck" Content="输入文本" IsChecked="True" /><CheckBox x:Name="PressEnterCheck" Content="按回车" IsChecked="True" /></StackPanel></StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><NumberBox x:Name="StartAtBox" Header="第几次命中开始" Value="1" Minimum="1" Maximum="1000000" /><NumberBox x:Name="EveryBox" Grid.Column="1" Header="每隔几次执行" Value="1" Minimum="1" Maximum="1000000" /><NumberBox x:Name="MaxExecutionsBox" Grid.Column="2" Header="最多执行（0 无限）" Value="1" Minimum="0" Maximum="1000000" /></Grid>
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><CheckBox x:Name="RemoteCheck" Content="远程判断" VerticalAlignment="Bottom" /><TextBox x:Name="RemoteUrlBox" Grid.Column="1" Header="远程 URL" Text="https://chybenzun.top" /><TextBox x:Name="RemoteKeywordBox" Grid.Column="2" Header="响应关键字" Text="continue" /><ComboBox x:Name="RemoteActionBox" Grid.Column="3" Header="命中关键字时" SelectedIndex="0" /></Grid>
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Foreground="{ThemeResource AppMutedBrush}" Text="自动输入只发送到选择时记录的 PID 与完整窗口标题；任一项变化都会拒绝发送。" TextWrapping="Wrap" />
                </Grid></ScrollViewer>
            </TabViewItem>
        </TabView>
        <Grid Grid.Row="3"><StackPanel Orientation="Horizontal" Spacing="8"><ProgressRing x:Name="Progress" Width="18" Height="18" IsActive="False" /><TextBlock x:Name="StatusText" Foreground="{ThemeResource AppMutedBrush}" Text="正在加载配置" /></StackPanel><TextBlock x:Name="MatchCountText" HorizontalAlignment="Right" Foreground="{ThemeResource AppMutedBrush}" Text="近期命中 0 条" /></Grid>
    </Grid>
</Page>

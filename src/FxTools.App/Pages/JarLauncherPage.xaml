<Page
    x:Class="FxTools.App.Pages.JarLauncherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="28" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource PageTitleStyle}" Text="JAR 启动" /><TextBlock Foreground="{ThemeResource AppMutedBrush}" Text="复制部署文件、启动 Java 服务，并按 PID 与端口双重校验停止。" /></StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Click="New_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Add" /><TextBlock Text="新建" /></StackPanel></Button>
                <Button Click="Save_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Save" /><TextBlock Text="保存" /></StackPanel></Button>
                <Button Click="Delete_Click" ToolTipService.ToolTip="删除项目"><SymbolIcon Symbol="Delete" /></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListView x:Name="ProjectList" SelectionMode="Single" SelectionChanged="ProjectList_SelectionChanged">
                <ListView.ItemTemplate><DataTemplate><Grid Padding="7" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Port}" Foreground="{ThemeResource AppMutedBrush}" /></Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
            <ScrollViewer Grid.Column="1"><StackPanel Spacing="10">
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions><TextBox x:Name="NameBox" Header="项目名称" /><NumberBox x:Name="PortBox" Grid.Column="1" Header="端口" Value="8080" Minimum="1" Maximum="65535" /><TextBox x:Name="ProfileBox" Grid.Column="2" Header="Spring Profile" /></Grid>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="SourceJarBox" Header="源 JAR" /><Button Grid.Column="1" VerticalAlignment="Bottom" Click="PickSourceJar_Click" ToolTipService.ToolTip="选择源 JAR"><SymbolIcon Symbol="OpenFile" /></Button></Grid>
                <TextBox x:Name="TargetJarBox" Header="目标 JAR" />
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox x:Name="SourceLibBox" Header="源 Lib（可选）" /><TextBox x:Name="TargetLibBox" Grid.Column="1" Header="目标 Lib（可选）" /></Grid>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox x:Name="JvmOptionsBox" Header="JVM 参数" PlaceholderText="-Xms256m -Xmx1g" /><TextBox x:Name="OtherOptionsBox" Grid.Column="1" Header="应用参数" /></Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CopyButton" Click="Copy_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Copy" /><TextBlock Text="复制部署文件" /></StackPanel></Button>
                    <Button x:Name="StartButton" Click="Start_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Play" /><TextBlock Text="启动" /></StackPanel></Button>
                    <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Stop" /><TextBlock Text="停止" /></StackPanel></Button>
                    <Button Click="OpenFolder_Click" ToolTipService.ToolTip="打开目标目录"><SymbolIcon Symbol="Folder" /></Button>
                    <Button Click="OpenLog_Click" ToolTipService.ToolTip="打开运行日志"><SymbolIcon Symbol="Document" /></Button>
                    <Button x:Name="CancelButton" Click="Cancel_Click" IsEnabled="False" ToolTipService.ToolTip="取消复制"><SymbolIcon Symbol="Cancel" /></Button>
                </StackPanel>
                <Border Style="{StaticResource SurfaceBorderStyle}"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="当前状态" /><TextBlock x:Name="RunStateText" FontSize="20" FontWeight="SemiBold" Text="未选择" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="日志位置" /><TextBlock x:Name="LogPathText" Text="--" TextWrapping="Wrap" /></StackPanel></Grid></Border>
            </StackPanel></ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><ProgressRing x:Name="Progress" Width="18" Height="18" IsActive="False" /><TextBlock x:Name="StatusText" Foreground="{ThemeResource AppMutedBrush}" Text="正在加载" /></StackPanel>
    </Grid>
</Page>

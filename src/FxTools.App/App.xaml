<Application
    x:Class="FxTools.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFF8FAFC" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#FFD8DEE8" />
                    <SolidColorBrush x:Key="AppMutedBrush" Color="#FF667085" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#FF067647" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#FFB54708" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FFB42318" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF202124" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#FF3C4043" />
                    <SolidColorBrush x:Key="AppMutedBrush" Color="#FFAEB4BD" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#FF53B483" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#FFF2B84B" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FFF97066" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource AppMutedBrush}" />
            </Style>
            <Style x:Key="SurfaceBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="MonospaceTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
